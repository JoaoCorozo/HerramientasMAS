# Vacío = peticiones a /api del mismo dominio (recomendado en Docker y Vercel)
NEXT_PUBLIC_API_URL=

# URL del backend vista desde el proceso Next (servidor), no desde el navegador
# Local: http://127.0.0.1:8000
# Docker Compose: http://backend:8000
# Vercel: https://tu-api.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# Opcional: Excels muy grandes / API en otro dominio → CROSS_SITE_AUTH en backend
# NEXT_PUBLIC_API_URL=https://tu-api.ejemplo.com
