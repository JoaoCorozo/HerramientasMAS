# Copiar a .env en la raíz del repo (no subir a git)
# docker compose --env-file .env up -d --build

# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambia_root_muy_seguro
MYSQL_DATABASE=herramientas
MYSQL_USER=herramientas
MYSQL_PASSWORD=cambia_password_muy_seguro
MYSQL_PORT=3306

# --- App ---
APP_ENV=production
# Generar: openssl rand -hex 32
JWT_SECRET_KEY=
APP_ENCRYPTION_KEY=
# Solo para el primer arranque (crear admin). Quitar después y cambiar la clave.
BOOTSTRAP_ADMIN_PASSWORD=admin123
ADMIN_MASTER_USER=admin

# URL pública del frontend (CORS + cookies). En servidor real: https://tu-dominio.com
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Puertos publicados en el host
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Interno (Compose). No hace falta cambiarlo si usas los servicios del compose.
# DATABASE_URL se arma en docker-compose.yml hacia el servicio "db"
