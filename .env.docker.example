# Copiar a .env en la raíz:  cp .env.docker.example .env
# Luego: docker compose up -d --build

APP_ENV=production

# MySQL (servicio "db" del compose)
MYSQL_ROOT_PASSWORD=cambia_root_seguro
MYSQL_DATABASE=herramientas
MYSQL_USER=herramientas
MYSQL_PASSWORD=cambia_mysql_seguro
MYSQL_PORT=3306

# Secrets (generar: openssl rand -hex 32)
JWT_SECRET_KEY=cambia_jwt_largo_aleatorio
APP_ENCRYPTION_KEY=cambia_encryption_largo_aleatorio

# Solo primer arranque; quitar después de crear admin
BOOTSTRAP_ADMIN_PASSWORD=AdminTemporal123!
ADMIN_MASTER_USER=admin

# URL pública con la que entrarán los usuarios (ajustar a tu dominio/IP)
# IMPORTANTE: debe coincidir con lo que escriben en el navegador (puerto incluido).
# Ejemplo AWS sin HTTPS: http://52.x.x.x:3001
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Puertos publicados en el host
FRONTEND_PORT=3000
BACKEND_PORT=8000

# false = cookies same-site vía proxy Next (/api)
CROSS_SITE_AUTH=false
# Con PUBLIC_FRONTEND_URL en http:// la cookie Secure se desactiva sola.
# Solo fuerza true cuando ya haya HTTPS delante (Nginx/Caddy).
# COOKIE_SECURE=false

# --- OIDC / Authentik (Google IdP; sin esto solo login local) ---
# OIDC_TENANTS=lms
# OIDC_ISSUER=https://authentik.netbird.grupomasconsultores.cl/application/o/herramientas-lms/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://herramientaslms.netbird.grupomasconsultores.cl/auth/callback
# OIDC_SCOPES=openid email profile
# OIDC_LOCAL_LOGIN_ENABLED=true
# OIDC_AUTO_CREATE_USERS=true

