# Copiar a backend/.env (no subir a git)

# --- Local ---
APP_ENV=development
DATABASE_URL=sqlite:///./users.db
JWT_SECRET_KEY=dev-local-cambiar-en-produccion
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MySQL (Docker / servidor) ---
# Opción A: URL completa
# DATABASE_URL=mysql+pymysql://herramientas:password@db:3306/herramientas?charset=utf8mb4
# Opción B: variables separadas (recomendado en Docker)
# MYSQL_HOST=db
# MYSQL_PORT=3306
# MYSQL_DATABASE=herramientas
# MYSQL_USER=herramientas
# MYSQL_PASSWORD=cambia_password

# --- Nube PostgreSQL (sync scripts / Neon) ---
POSTGRES_DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require

# --- Producción Render / Docker ---
# JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY=
# CORS_ORIGINS=https://tu-dominio.com
# PUBLIC_FRONTEND_URL=https://tu-dominio.com
# MATRIZ_CURSOS_PATH=/app/cursos bex Moodle.xlsx
# CROSS_SITE_AUTH=false
# BOOTSTRAP_ADMIN_PASSWORD=   # solo primer arranque

APP_ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=20971520
# COMPRESOR_VIDEO_MAX_BYTES=0
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
