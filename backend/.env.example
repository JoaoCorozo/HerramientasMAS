# Copiar a backend/.env (no subir a git)

# --- Local ---
APP_ENV=development
DATABASE_URL=sqlite:///./users.db
JWT_SECRET_KEY=dev-local-cambiar-en-produccion
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MySQL (Docker / servidor) ---
# MYSQL_HOST=db
# MYSQL_PORT=3306
# MYSQL_DATABASE=herramientas
# MYSQL_USER=herramientas
# MYSQL_PASSWORD=cambia_password

# --- Nube PostgreSQL ---
POSTGRES_DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require

# --- Producción ---
# JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY=
# CORS_ORIGINS=http://herramientaslms.netbird.grupomasconsultores.cl
# PUBLIC_FRONTEND_URL=http://herramientaslms.netbird.grupomasconsultores.cl
# CROSS_SITE_AUTH=false
# BOOTSTRAP_ADMIN_PASSWORD=

APP_ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=20971520
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- OIDC / Authentik (Google como IdP) ---
# Redirect EXACTO al registrado en Authentik:
# OIDC_TENANTS=lms
# OIDC_ISSUER=https://authentik.netbird.grupomasconsultores.cl/application/o/herramientas-lms/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://herramientaslms.netbird.grupomasconsultores.cl/auth/callback
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_CREATE_USERS=true
# OIDC_LOCAL_LOGIN_ENABLED=true
# OIDC_ALLOWED_DOMAINS=
